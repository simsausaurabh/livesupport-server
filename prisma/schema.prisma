generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  STARTER
  TEAM
  BUSINESS
}

enum AgentRole {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum AgentStatus {
  ONLINE
  AWAY
  OFFLINE
}

enum ConversationStatus {
  OPEN
  ASSIGNED
  BOT
  RESOLVED
  ABANDONED
}

enum MessageSenderType {
  VISITOR
  AGENT
  BOT
  SYSTEM
}

enum KnowledgeSourceType {
  URL
  FILE
  MANUAL
}

enum ChatbotStatus {
  ACTIVE
  PAUSED
  DRAFT
}

model Organization {
  id                   String    @id @default(cuid())
  name                 String    @db.VarChar(150)
  slug                 String    @unique @db.VarChar(100)
  domain               String?   @db.VarChar(255)

  plan                 Plan      @default(FREE)
  billingCycle         String    @default("monthly") @db.VarChar(10)
  stripeCustomerId     String?   @unique @db.VarChar(100)
  stripeSubscriptionId String?   @unique @db.VarChar(100)
  trialEndsAt          DateTime?
  billingEmail         String?   @db.VarChar(255)

  widgetKey            String    @unique @default(cuid()) @db.VarChar(100)
  widgetSettingsJson   String    @db.Text @map("widget_settings")

  monthlyVisitorLimit  Int       @default(1000)
  monthlyConvLimit     Int       @default(250)
  chatHistoryMonths    Int       @default(6)
  maxAgents            Int       @default(1)
  maxChatbots          Int       @default(0)

  currentMonthVisitors Int       @default(0)
  currentMonthConvs    Int       @default(0)
  visitorCountResetAt  DateTime  @default(now())

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  agents              Agent[]
  visitors            Visitor[]
  conversations       Conversation[]
  cannedResponses     CannedResponse[]
  webhooks            Webhook[]
  apiKeys             ApiKey[]
  tags                Tag[]
  knowledgeSources    KnowledgeSource[]
  chatbots            Chatbot[]

  @@index([widgetKey])
  @@index([slug])
  @@map("organizations")
}

model Agent {
  id             String      @id @default(cuid())
  organizationId String
  email          String      @db.VarChar(255)
  name           String      @db.VarChar(150)
  passwordHash   String?     @db.VarChar(255)
  avatarUrl      String?     @db.VarChar(500)
  role           AgentRole   @default(AGENT)
  status         AgentStatus @default(OFFLINE)
  isActive       Boolean     @default(true)
  googleId       String?     @unique @db.VarChar(100)
  ratingAvg      Float       @default(0)
  ratingCount    Int         @default(0)
  lastSeenAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[]   @relation("AssignedAgent")
  messages              Message[]
  cannedResponses       CannedResponse[]
  ratings               AgentRating[]
  sessions              AgentSession[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@map("agents")
}

model AgentSession {
  id        String   @id @default(cuid())
  agentId   String
  token     String   @unique @db.VarChar(512)
  expiresAt DateTime
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("agent_sessions")
}

model Visitor {
  id             String   @id @default(cuid())
  organizationId String
  fingerprint    String   @db.VarChar(200)
  email          String?  @db.VarChar(255)
  name           String?  @db.VarChar(150)
  ipAddress      String?  @db.VarChar(45)
  country        String?  @db.VarChar(2)
  city           String?  @db.VarChar(100)
  browserName    String?  @db.VarChar(100)
  osName         String?  @db.VarChar(100)
  currentUrl     String?  @db.VarChar(2000)
  referrer       String?  @db.VarChar(2000)
  customDataJson String   @db.Text @map("custom_data")
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([organizationId, fingerprint])
  @@index([organizationId])
  @@index([fingerprint])
  @@map("visitors")
}

model Conversation {
  id              String             @id @default(cuid())
  organizationId  String
  visitorId       String
  assignedAgentId String?
  chatbotId       String?
  status          ConversationStatus @default(OPEN)
  subject         String?            @db.VarChar(255)
  aiSummary       String?            @db.Text
  botHandedOff    Boolean            @default(false)
  handoffReason   String?            @db.VarChar(500)
  rating          Int?
  ratingComment   String?            @db.VarChar(1000)
  durationSeconds Int?
  firstResponseSeconds Int?
  messageCount    Int                @default(0)
  resolvedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitor          Visitor           @relation(fields: [visitorId], references: [id])
  assignedAgent    Agent?            @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  chatbot          Chatbot?          @relation(fields: [chatbotId], references: [id])
  messages         Message[]
  conversationTags ConversationTag[]
  agentRatings     AgentRating[]

  @@index([organizationId])
  @@index([visitorId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([createdAt])
  @@map("conversations")
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  senderType     MessageSenderType
  senderId       String?
  content        String            @db.Text
  contentType    String            @default("text") @db.VarChar(20)
  isAiSuggested  Boolean           @default(false)
  isInternalNote Boolean           @default(false)
  readAt         DateTime?
  createdAt      DateTime          @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        Agent?       @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

model Tag {
  id             String  @id @default(cuid())
  organizationId String
  name           String  @db.VarChar(50)
  color          String  @default("#3b82f6") @db.VarChar(7)
  isAutoApplied  Boolean @default(false)

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations ConversationTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("tags")
}

model ConversationTag {
  conversationId String
  tagId          String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@map("conversation_tags")
}

model CannedResponse {
  id               String   @id @default(cuid())
  organizationId   String
  shortcut         String   @db.VarChar(50)
  title            String   @db.VarChar(200)
  content          String   @db.Text
  createdByAgentId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByAgent Agent        @relation(fields: [createdByAgentId], references: [id])

  @@unique([organizationId, shortcut])
  @@index([organizationId])
  @@map("canned_responses")
}

// ── Knowledge Base ────────────────────────────

model KnowledgeSource {
  id             String              @id @default(cuid())
  organizationId String
  type           KnowledgeSourceType
  title          String              @db.VarChar(255)
  sourceUrl      String?             @db.VarChar(2000)
  fileName       String?             @db.VarChar(255)
  contentText    String              @db.Text
  isIndexed      Boolean             @default(false)
  charCount      Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chatbots     ChatbotKnowledge[]

  @@index([organizationId])
  @@map("knowledge_sources")
}

// ── AI Chatbots ───────────────────────────────

model Chatbot {
  id              String        @id @default(cuid())
  organizationId  String
  name            String        @db.VarChar(100)
  persona         String        @db.Text
  welcomeMessage  String        @db.VarChar(500)
  handoffMessage  String        @db.VarChar(500)
  handoffTriggers String        @db.Text
  status          ChatbotStatus @default(DRAFT)
  autoHandoff     Boolean       @default(true)
  handoffKeywords String        @db.Text
  totalChats      Int           @default(0)
  handoffCount    Int           @default(0)
  resolutionCount Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  knowledgeSources ChatbotKnowledge[]
  conversations    Conversation[]

  @@index([organizationId])
  @@map("chatbots")
}

model ChatbotKnowledge {
  chatbotId         String
  knowledgeSourceId String

  chatbot          Chatbot         @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  knowledgeSource  KnowledgeSource @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)

  @@id([chatbotId, knowledgeSourceId])
  @@map("chatbot_knowledge")
}

model AgentRating {
  id             String   @id @default(cuid())
  conversationId String   @unique
  agentId        String
  organizationId String
  score          Int
  comment        String?  @db.VarChar(1000)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id])

  @@index([agentId])
  @@index([organizationId])
  @@map("agent_ratings")
}

model Webhook {
  id              String    @id @default(cuid())
  organizationId  String
  url             String    @db.VarChar(2000)
  secret          String    @db.VarChar(255)
  eventsJson      String    @db.Text @map("events")
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  failureCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@map("webhooks")
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  event      String   @db.VarChar(100)
  payload    String   @db.Text
  statusCode Int?
  response   String?  @db.Text
  success    Boolean
  createdAt  DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@map("webhook_deliveries")
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String    @db.VarChar(100)
  keyHash        String    @unique @db.VarChar(255)
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}
